API_BASE_URL=http://127.0.0.1:8000
# Server-only; never use a secret or service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional for regular sign-in; required for /admin account management. Server-only.
SUPABASE_SECRET_KEY=
# Optional canonical origin behind a trusted reverse proxy.
# Same-origin localhost, 127.0.0.1, and Vercel deployment URLs work without this.
APP_ORIGIN=

